#!/bin/bash
set -euo pipefail
APP_NAME="${TRIM_APPNAME:-HermesWebUI}"
APP_DIR="${TRIM_APPDEST:-/var/apps/${APP_NAME}}"
DATA_DIR="${TRIM_PKGVAR:-${APP_DIR}/var}"

# 诊断日志 — 记录每次调用环境变量, 便于排查应用中心启动失败
DIAG="${DATA_DIR}/webui-diag.log"
mkdir -p "${DATA_DIR}" 2>/dev/null
{
    echo "=== $(date '+%F %T') call: '${1:-<none>}' USER=$(id -un) UID=$(id -u) PWD=$(pwd) ==="
    echo "  TRIM_APPDEST=${TRIM_APPDEST:-<unset>}"
    echo "  TRIM_PKGVAR=${TRIM_PKGVAR:-<unset>}"
    echo "  TRIM_APPNAME=${TRIM_APPNAME:-<unset>}"
    echo "  TRIM_SERVICE_PORT=${TRIM_SERVICE_PORT:-<unset>}"
    echo "  PATH=${PATH:-<unset>}"
} >> "${DIAG}" 2>&1

WEBUI_PORT=8787
# 兼容 fnOS 两种解压位置: 实际在 ${APP_DIR}/server, 部分版本在 ${APP_DIR}/target/server
if [ -d "${APP_DIR}/server" ]; then
    WEBUI_SRC="${APP_DIR}/server"
elif [ -d "${APP_DIR}/target/server" ]; then
    WEBUI_SRC="${APP_DIR}/target/server"
else
    WEBUI_SRC="${APP_DIR}/target/server"
fi
WEBUI_LOG="${DATA_DIR}/webui.log"
WEBUI_PID="${DATA_DIR}/webui.pid"
WEBUI_VENV="${DATA_DIR}/venv"
WEBUI_STATE="${DATA_DIR}/state"
HERMES_HOME="${DATA_DIR}/hermes_home"

CONFIG_FILE="${DATA_DIR}/gateway.env"
[ -f "${CONFIG_FILE}" ] && source "${CONFIG_FILE}"
REMOTE_GATEWAY="${GATEWAY_URL:-http://127.0.0.1:8642}"
REMOTE_DASHBOARD="${DASHBOARD_URL:-http://127.0.0.1:8642}"
REMOTE_KEY="${GATEWAY_KEY:-webui-gateway-key-2026}"
USE_PROXY_FLAG="${USE_PROXY:-true}"
# WebUI 只连本机 Gateway，不需要代理
PROXY_URL="${PROXY_URL:-}"

mkdir -p "${DATA_DIR}" "${WEBUI_STATE}" "${HERMES_HOME}"
[ ! -f "${WEBUI_STATE}/settings.json" ] && echo '{"theme":"light","skin":"codex","language":"zh"}' > "${WEBUI_STATE}/settings.json"

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "${WEBUI_LOG}"; }

ensure_venv() {
  [ -f "${WEBUI_VENV}/bin/python" ] && return 0
  echo "  [ensure_venv] creating venv at ${WEBUI_VENV}" >> "${DIAG}" 2>&1
  /usr/bin/python3 -m venv "${WEBUI_VENV}" >> "${DIAG}" 2>&1 || { echo "  [ensure_venv] venv create FAILED rc=$?" >> "${DIAG}"; return 1; }
  "${WEBUI_VENV}/bin/pip" install pyyaml cryptography >> "${WEBUI_LOG}" 2>&1 || echo "  [ensure_venv] pip install warn" >> "${DIAG}"
}

start_webui() {
  [ -f "${WEBUI_PID}" ] && kill -0 "$(cat "${WEBUI_PID}" 2>/dev/null)" 2>/dev/null && return 0
  echo "  [start] WEBUI_SRC=${WEBUI_SRC:-<unset>} WEBUI_VENV=${WEBUI_VENV:-<unset>}" >> "${DIAG}" 2>&1
  ensure_venv || { echo "  [start] ensure_venv failed" >> "${DIAG}"; log "ERROR: venv failed"; return 1; }
  [ ! -f "${WEBUI_SRC}/server.py" ] && { echo "  [start] server.py missing at ${WEBUI_SRC}" >> "${DIAG}"; log "ERROR: source missing"; return 1; }

  # 不设代理环境变量 — 局域网 Gateway 不需要走代理
  unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY no_proxy

  export HERMES_HOME="${HERMES_HOME}"
  export HERMES_API_URL="${REMOTE_DASHBOARD}"
  export HERMES_WEBUI_CHAT_BACKEND=gateway
  export HERMES_WEBUI_GATEWAY_BASE_URL="${REMOTE_GATEWAY}"
  export HERMES_WEBUI_GATEWAY_API_KEY="${REMOTE_KEY}"
  export HERMES_WEBUI_HOST="0.0.0.0"
  export HERMES_WEBUI_PORT="${WEBUI_PORT}"
  export HERMES_WEBUI_STATE_DIR="${WEBUI_STATE}"
  export HERMES_WEBUI_SKIP_ONBOARDING=1
  export HERMES_WEBUI_DISABLE_AGENT_CHECK=1
  # 信任反向代理的 X-Forwarded-Host — 解决移动端/外部域名访问的 CSRF Origin 跨域
  # (反向代理转发 hermeswebui.techysy.fnos.net 时 Origin 与 Host 不同, 需信任代理头)
  export HERMES_WEBUI_TRUST_FORWARDED_HOST=true
  export HOST="0.0.0.0"
  export PORT="${WEBUI_PORT}"

  cd "${WEBUI_SRC}"
  nohup "${WEBUI_VENV}/bin/python" server.py >> "${WEBUI_LOG}" 2>&1 &
  echo $! > "${WEBUI_PID}"
  echo "  [start] launched server.py pid=$(cat "${WEBUI_PID}" 2>/dev/null)" >> "${DIAG}" 2>&1

  for i in $(seq 1 30); do
    curl -sf "http://127.0.0.1:${WEBUI_PORT}/health" >/dev/null 2>&1 && log "WebUI started (PID $(cat ${WEBUI_PID}))" && return 0
    sleep 1
  done
  # 启动超时 — 记录诊断信息
  echo "  [start] TIMEOUT after 30s" >> "${DIAG}" 2>&1
  PIDX=$(cat "${WEBUI_PID}" 2>/dev/null)
  if kill -0 "${PIDX}" 2>/dev/null; then
      echo "  [start] process alive pid=${PIDX}, but health not responding" >> "${DIAG}"
  else
      echo "  [start] process DEAD pid=${PIDX}" >> "${DIAG}"
  fi
  echo "  [start] webui.log tail:" >> "${DIAG}" 2>&1
  tail -5 "${WEBUI_LOG}" 2>/dev/null >> "${DIAG}" 2>&1
  log "WebUI start timeout"
}

stop() {
  [ -f "${WEBUI_PID}" ] || return 0
  PID=$(cat "${WEBUI_PID}")
  kill "${PID}" 2>/dev/null || true
  for i in 1 2 3; do kill -0 "${PID}" 2>/dev/null || { rm -f "${WEBUI_PID}"; log "Stopped"; return 0; }; sleep 1; done
  kill -9 "${PID}" 2>/dev/null || true
  rm -f "${WEBUI_PID}"
  log "Force stopped"
}

status() {
  if [ -f "${WEBUI_PID}" ] && kill -0 "$(cat "${WEBUI_PID}" 2>/dev/null)" 2>/dev/null; then
    echo "running"
    return 0
  fi
  # stopped — 必须返回非零, 否则 fnOS 误判为 running, 从不调用 start
  echo "stopped"
  return 1
}

case "${1:-start}" in
  start) start_webui ;;
  stop) stop ;;
  status) status ;;
  restart) stop; sleep 2; start_webui ;;
  *) echo "Usage: $0 {start|stop|status|restart}"; exit 1 ;;
esac
